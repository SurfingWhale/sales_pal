NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# xAI Grok vision — server-side, for "Scan Gambar" lead import (Flow B)
XAI_API_KEY=your_xai_api_key_here
# optional: override the vision model (default: grok-2-vision-1212)
XAI_VISION_MODEL=grok-2-vision-1212

# Production host only, once its /__/auth/handler is an authorized redirect URI
# in Google Cloud (see lib/firebase.ts). Leave empty for previews and localhost.
NEXT_PUBLIC_AUTH_HOST=

# Threads Radar (Hunting): a Meta app with the Threads use case. The app id is
# public; the secret stays on the server. Leave empty to hide the Radar.
NEXT_PUBLIC_THREADS_APP_ID=
THREADS_APP_SECRET=

# Server identity (docs/prd/PRD-006, P0). Service-account JSON from Firebase
# Console → Project settings → Service accounts → Generate new private key,
# pasted raw or base64-encoded. Needed for the token vault and scan quotas;
# without it Threads cannot connect and quotas fall back to per-instance memory.
FIREBASE_SERVICE_ACCOUNT=
# Grok scans per user per day (default 40)
SCAN_DAILY_LIMIT=40
