rules_version = '2';

// SalesPal's Firestore — and the one place every website's leads flow into.
//
//   users/{uid}/...        SalesPal's own data. Each account sees only its own.
//   connections/, usage/   Server only: platform tokens and quotas.
//   inbound_leads/{id}     Leads sent by the websites (Visufavor, BeUntamed,
//                          UNTMD Sports). Anyone may ADD one, in exactly the
//                          shape below; only the owner may read them, mark them
//                          imported, or delete them. See docs/LEADS-PRD.md in
//                          the Visufavor repo for the standard.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who runs the pipeline. A verified email, so a typed-in address cannot
    // pose as one.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['fauzymuhamad43@gmail.com'];
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Guilds (docs/prd/PRD-007): shared team spaces with roles --------
    //   leader   owns the guild: names it, sets roles, invites anyone, hands over
    //   officer  runs the team: sees every deal, sets targets, invites members
    //   member   sells: sees and works only the deals they own
    //   viewer   reads the guild's frozen reports and members, nothing else
    function guildPath(g) { return /databases/$(database)/documents/guilds/$(g); }
    function memberPath(g, uid) { return /databases/$(database)/documents/guilds/$(g)/members/$(uid); }
    function inGuild(g) { return request.auth != null && exists(memberPath(g, request.auth.uid)); }
    function myRole(g) { return get(memberPath(g, request.auth.uid)).data.role; }
    function hasRole(g, roles) { return inGuild(g) && myRole(g) in roles; }
    function seller(g) { return hasRole(g, ['leader', 'officer', 'member']); }
    function manager(g) { return hasRole(g, ['leader', 'officer']); }
    function validInvite(g, code, role) {
      let p = /databases/$(database)/documents/guilds/$(g)/invites/$(code);
      return code is string && exists(p) && get(p).data.role == role && get(p).data.expiresAt > request.time.toMillis();
    }
    function guildShape(d) {
      return d.keys().hasOnly(['name', 'leaderUid', 'titles', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80;
    }
    function memberShape(d) {
      return d.keys().hasOnly(['uid', 'name', 'email', 'role', 'inviteCode', 'joinedAt'])
        && d.role in ['leader', 'officer', 'member', 'viewer'];
    }

    match /guilds/{g} {
      allow read: if inGuild(g);
      // Founding: the guild and its leader's member doc go in one batch.
      allow create: if request.auth != null && guildShape(request.resource.data)
        && request.resource.data.leaderUid == request.auth.uid
        && getAfter(memberPath(g, request.auth.uid)).data.role == 'leader';
      // The leader renames it or hands it over; a handover makes the new leader
      // a leader and the old one not, in the same batch.
      allow update: if hasRole(g, ['leader']) && guildShape(request.resource.data)
        && (request.resource.data.leaderUid == resource.data.leaderUid
            || (getAfter(memberPath(g, request.resource.data.leaderUid)).data.role == 'leader'
                && getAfter(memberPath(g, request.auth.uid)).data.role != 'leader'));
      allow delete: if false;

      match /members/{uid} {
        allow read: if inGuild(g);
        // Join yourself: as founding leader of a new guild, or with an invite
        // for exactly the role you take.
        allow create: if request.auth != null && request.auth.uid == uid
          && memberShape(request.resource.data) && request.resource.data.uid == uid
          && ((request.resource.data.role == 'leader' && !exists(guildPath(g))
                && getAfter(guildPath(g)).data.leaderUid == uid)
              || (request.resource.data.role != 'leader'
                && validInvite(g, request.resource.data.get('inviteCode', ''), request.resource.data.role)));
        allow update: if inGuild(g) && memberShape(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && ((request.auth.uid == uid && request.resource.data.role == resource.data.role)
              || (myRole(g) == 'leader' && request.auth.uid != uid
                  && (request.resource.data.role != 'leader'
                      || getAfter(guildPath(g)).data.leaderUid == uid))
              || (myRole(g) == 'leader' && request.auth.uid == uid && request.resource.data.role == 'officer'
                  && getAfter(guildPath(g)).data.leaderUid != uid)
              || (myRole(g) == 'officer' && resource.data.role in ['member', 'viewer']
                  && request.resource.data.role in ['member', 'viewer']));
        // Leave (a leader hands over first), or be removed by those above you.
        allow delete: if inGuild(g)
          && ((request.auth.uid == uid && resource.data.role != 'leader')
              || (myRole(g) == 'leader' && request.auth.uid != uid)
              || (myRole(g) == 'officer' && resource.data.role in ['member', 'viewer']));
      }

      // An invite is read by whoever holds its code (the link), never listed by outsiders.
      match /invites/{code} {
        allow get: if request.auth != null;
        allow list: if manager(g);
        allow create: if request.resource.data.keys().hasOnly(['role', 'guildName', 'createdBy', 'createdAt', 'expiresAt'])
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.expiresAt is number
          && ((hasRole(g, ['leader']) && request.resource.data.role in ['officer', 'member', 'viewer'])
              || (hasRole(g, ['officer']) && request.resource.data.role in ['member', 'viewer']));
        allow delete: if manager(g);
      }

      // Deals: a member works their own; leader and officer see and fix all.
      // The first-touch source stays as logged, unless it was still unknown.
      match /deals/{id} {
        allow read: if manager(g) || (inGuild(g) && resource.data.ownerUid == request.auth.uid);
        allow create: if seller(g) && request.resource.data.ownerUid is string
          && (request.resource.data.ownerUid == request.auth.uid || manager(g));
        allow update: if (manager(g)
              || (seller(g) && resource.data.ownerUid == request.auth.uid
                  && request.resource.data.ownerUid == resource.data.ownerUid))
          && (request.resource.data.firstTouch == resource.data.firstTouch
              || resource.data.firstTouch.channel == 'Ga tau');
        allow delete: if manager(g) || (seller(g) && resource.data.ownerUid == request.auth.uid);
      }

      match /targets/{id} {
        allow read: if inGuild(g);
        allow write: if manager(g);
      }
      match /reports/{id} {
        allow read: if inGuild(g);
        allow write: if manager(g);
      }
    }

    // Server-only (lib/serverAuth.ts, Admin SDK): platform tokens and usage
    // quotas. No browser — not even the owner's — may read or write them.
    match /connections/{id} {
      allow read, write: if false;
    }
    match /usage/{id} {
      allow read, write: if false;
    }

    match /inbound_leads/{id} {
      allow create: if validLead(request.resource.data);
      allow read, delete: if isOwner();
      // SalesPal marks a lead imported; nothing else about it changes.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'importedAt', 'importedBy'])
        && request.resource.data.status in ['new', 'imported', 'spam'];
    }

    // ---- the lead's shape (v1) ------------------------------------------
    function str(v, max) { return v is string && v.size() <= max; }
    function opt(m, k, max) { return !(k in m) || str(m[k], max); }

    function validLead(d) {
      return d.keys().hasOnly(['v', 'site', 'siteUrl', 'offer', 'contact', 'answers', 'attribution', 'account', 'createdAt', 'status'])
        && d.keys().hasAll(['v', 'site', 'contact', 'createdAt', 'status'])
        && d.v == 1
        && d.site in ['visufavor', 'beuntamed', 'untmd-sports']
        && d.status == 'new'
        && d.createdAt == request.time
        && opt(d, 'siteUrl', 200)
        && validContact(d.contact)
        && (!('offer' in d) || validOffer(d.offer))
        && (!('answers' in d) || validAnswers(d.answers))
        && (!('attribution' in d) || validAttribution(d.attribution))
        && (!('account' in d) || validAccount(d.account));
    }

    // A name, and at least one way to reach them.
    function validContact(c) {
      return c is map
        && c.keys().hasOnly(['name', 'email', 'whatsapp', 'business'])
        && str(c.name, 120) && c.name.size() > 0
        && opt(c, 'email', 200) && opt(c, 'whatsapp', 30) && opt(c, 'business', 160)
        && (('email' in c && c.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
            || ('whatsapp' in c && c.whatsapp.matches('^\\+?[0-9 -]{8,20}$')));
    }

    function validOffer(o) {
      return o is map && o.keys().hasOnly(['code', 'kind', 'value'])
        && str(o.code, 40) && str(o.kind, 20)
        && o.value is number && o.value >= 0 && o.value <= 100;
    }

    function validAnswers(a) {
      return a is map && a.keys().hasOnly(['need', 'timing', 'heardFrom', 'budget', 'message'])
        && opt(a, 'need', 120) && opt(a, 'timing', 60) && opt(a, 'heardFrom', 60)
        && opt(a, 'budget', 60) && opt(a, 'message', 600);
    }

    // Where the visitor came from: ads, links, search. Kept whole so a paid
    // campaign can be traced to the leads it brought.
    function validAttribution(t) {
      return t is map && t.keys().hasOnly(['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
                                          'fbclid', 'gclid', 'ttclid', 'referrer', 'landing', 'firstSeenAt'])
        && opt(t, 'utm_source', 100) && opt(t, 'utm_medium', 100) && opt(t, 'utm_campaign', 150)
        && opt(t, 'utm_content', 150) && opt(t, 'utm_term', 150)
        && opt(t, 'fbclid', 300) && opt(t, 'gclid', 300) && opt(t, 'ttclid', 300)
        && opt(t, 'referrer', 300) && opt(t, 'landing', 300) && opt(t, 'firstSeenAt', 40);
    }

    // The website account the lead signed in with (that site's own Firebase
    // project), so SalesPal can tell repeat sign-ups apart.
    function validAccount(a) {
      return a is map && a.keys().hasOnly(['provider', 'uid', 'project'])
        && opt(a, 'provider', 40) && opt(a, 'uid', 128) && opt(a, 'project', 60);
    }
  }
}
