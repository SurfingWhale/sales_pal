{
  "name": "SalesPal",
  "short_name": "SalesPal",
  "description": "AI-powered Sales Assistant",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#f0f2f5",
  "theme_color": "#f0f2f5",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            ".txt",
            "application/zip",
            ".zip",
            "text/vcard",
            "text/x-vcard",
            ".vcf"
          ]
        }
      ]
    }
  }
}
